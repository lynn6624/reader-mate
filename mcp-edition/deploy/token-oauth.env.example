# Optional management features; merge into the TOKEN service environment.
# No Flask/Authlib dependencies are needed in that process.
READER_OAUTH_MANAGEMENT=0
READER_OAUTH_ISSUER=https://token.example.com
READER_OAUTH_RESOURCE=https://token.example.com/mcp
READER_OAUTH_DB=/opt/reader-mate/state/oauth/oauth.sqlite3
TOKEN_PUBLIC_ORIGIN=https://token.example.com
# CLI init is still required; the portal never creates/replaces an OAuth database.
# The MCP service must separately enable OAuth with the same issuer/resource/DB.
