# Optional MCP-only feature. Leave disabled until isolated HTTPS/client/resource acceptance.
# Merge these explicit settings into the MCP service environment; do not replace legacy settings.
READER_OAUTH_ENABLED=0
READER_OAUTH_ISSUER=https://oauth-mcp.example.com
READER_OAUTH_RESOURCE=https://oauth-mcp.example.com/mcp
READER_OAUTH_DB=/var/lib/reader-mate/oauth/oauth.sqlite3
READER_OAUTH_ACCESS_TTL=900
READER_OAUTH_REFRESH_TTL=2592000
# No signing key: browser sessions use random cookies with server-side hashed state.
# CLI init is required; the service refuses to create or overwrite a database.
# Linux: directory 0700, database/invitation output 0600. Windows: equivalent owner-only ACLs.
